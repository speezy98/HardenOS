POSTGRES_HOST=10.220.0.11
POSTGRES_PORT=5432
POSTGRES_DB=hardenos
POSTGRES_USER=hardenos
POSTGRES_PASSWORD=
SECRET_KEY=
FLASK_ENV=development

# JWT — si JWT_SECRET_KEY est vide, on dérive de SECRET_KEY (clé dédiée recommandée).
# Durées en secondes : 3600 = 1 h (access), 604800 = 7 jours (refresh).
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# Clé de chiffrement Fernet des credentials SSH au repos. Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

AGENT_CA_KEY=/etc/hardenos/ca.key
AGENT_CA_CERT=/etc/hardenos/ca.crt

# Certificat serveur HTTPS du backend lui-même (agents -> backend, port 5001).
# Émis une fois avec : flask --app wsgi issue-backend-cert --san <ip-ou-hostname>
BACKEND_TLS_CERT=/etc/hardenos/backend.crt
BACKEND_TLS_KEY=/etc/hardenos/backend.key

# Clé Ed25519 dédiée à la signature des scripts de remédiation Windows,
# vérifiée côté agent avant exécution. Séparée de la CA TLS ci-dessus.
# Émise une fois avec : flask --app wsgi issue-signing-key
SCRIPT_SIGNING_KEY_PATH=/etc/hardenos/script_signing.key