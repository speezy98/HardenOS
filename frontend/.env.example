# URL relative : les appels /api/... passent par le proxy Vite (→ localhost:5001,
# configuré dans vite.config.js). Garder une base relative évite de coder le
# port backend en dur et empêche le contournement du proxy par une URL absolue.
VITE_API_BASE_URL=/api
VITE_APP_TITLE=HardenOS

# Cible réelle du proxy Vite (backend), lue dans vite.config.js — PAS exposée
# au navigateur (contrairement aux variables VITE_* ci-dessus). http par
# défaut si absente : fonctionne sans certificats déjà générés. Ne définir
# qu'en https si BACKEND_TLS_CERT/BACKEND_TLS_KEY sont configurés et actifs
# côté backend (cf. backend/.env.example).
# VITE_BACKEND_URL=http://localhost:5001